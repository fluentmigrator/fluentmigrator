<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildProjectDirectory)\FluentMigrator.targets" Condition="Exists('$(MSBuildProjectDirectory)\FluentMigrator.targets')" />

  <PropertyGroup>
    <!-- In the real world, you would typically not have multiple target frameworks. However, this sample demonstrates it working against .NET Framework and .NET. -->
    <TargetFrameworks>net48;net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluentMigrator.Example.Migrations\FluentMigrator.Example.Migrations.csproj" />
  </ItemGroup>

  <!--
    This sample deliberately consumes FluentMigrator.MSBuild as a published NuGet package rather
    than as a project reference, so that it exercises the same code path a real consumer would.
    The version lives in Directory.Packages.props in the repository root.
  -->
  <ItemGroup>
    <PackageReference Include="FluentMigrator.MSBuild" GeneratePathProperty="true" />
  </ItemGroup>

  <PropertyGroup>
    <FluentMigratorTfm Condition="'$(MSBuildRuntimeType)' == 'Core' And '$(TargetFramework)' == 'net8.0'">net8.0</FluentMigratorTfm>
    <FluentMigratorTfm Condition="'$(MSBuildRuntimeType)' == 'Core' And '$(TargetFramework)' == 'net9.0'">net9.0</FluentMigratorTfm>
    <FluentMigratorTfm Condition="'$(MSBuildRuntimeType)' == 'Core' And '$(TargetFramework)' == 'net10.0'">net10.0</FluentMigratorTfm>
    <FluentMigratorTfm Condition="'$(MSBuildRuntimeType)' == 'Full'">net48</FluentMigratorTfm>
    <FluentMigratorMSBuildAssemblyPath>$(PKGFluentMigrator_MSBuild)\tasks\$(FluentMigratorTfm)\FluentMigrator.MSBuild.dll</FluentMigratorMSBuildAssemblyPath>
  </PropertyGroup>

  <Choose>
    <When Condition="'$(TargetFramework)' == 'net48' ">
      <PropertyGroup>
        <MigrationAssembly>$(MSBuildThisFileDirectory)..\FluentMigrator.Example.Migrations\bin\$(Configuration)\netstandard2.0\FluentMigrator.Example.Migrations.dll</MigrationAssembly>
      </PropertyGroup>
    </When>
    <When Condition="'$(TargetFramework)' != 'net48' ">
      <PropertyGroup>
        <MigrationAssembly>$(MSBuildThisFileDirectory)..\FluentMigrator.Example.Migrations\bin\$(Configuration)\$(TargetFramework)\FluentMigrator.Example.Migrations.dll</MigrationAssembly>
      </PropertyGroup>
    </When>
  </Choose>

  <Target Name="Migrate">

    <Error Condition="'$(FluentMigratorMSBuildAssemblyPath)' == ''" Text="FluentMigratorMSBuildAssemblyPath is not set." />
    <Error Condition="'$(MigrationAssembly)' == ''" Text="MigrationAssembly is not set." />
    
    <Message Text="Starting FluentMigrator Migration using $(FluentMigratorMSBuildAssemblyPath)" Importance="High" />
    <Message Text="Starting FluentMigrator Migration using MigrationAssembly  $(MigrationAssembly)" Importance="High" />

    <Migrate Database="sqlserver2016" Connection="Data Source=(local);Database=FluentMigratorExample;Trusted_Connection=true" Target="$(MigrationAssembly)" UseMsBuildLogging="true">
    </Migrate>
  </Target>

</Project>
