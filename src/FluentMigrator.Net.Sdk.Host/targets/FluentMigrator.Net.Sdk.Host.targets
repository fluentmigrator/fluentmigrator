<Project>

  <!--
    Imported here rather than from Sdk.props on purpose: a host context pack
    reacts to $(HostContexts) and to its own version property, both of which
    a project body sets after Sdk.props has already been evaluated. Items a
    pack contributes — including PackageReference — are still evaluation
    scope, so restore sees them normally.
  -->
  <Import Project="$(MSBuildThisFileDirectory)FluentMigrator.Net.Sdk.Host.Contexts.props" />

  <PropertyGroup>
    <HostIntermediateManifestPath>$(IntermediateOutputPath)$(HostManifestFileName)</HostIntermediateManifestPath>
    <HostManifestPath>$(OutputPath)$(HostManifestFileName)</HostManifestPath>
  </PropertyGroup>

  <UsingTask TaskName="FluentMigrator.Net.Sdk.Host.Tasks.BuildHostManifest"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)../tasks/BuildHostManifest.cs" />
    </Task>
  </UsingTask>

  <!--
    Which of Names this build received as global properties. The same task
    as FluentMigrator.Net.Sdk's: the two packages ship separately, so each
    carries its own copy.
  -->
  <UsingTask TaskName="FindHostGlobalProperties"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Names ParameterType="System.String[]" Required="true" />
      <Found ParameterType="System.String[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var found = new System.Collections.Generic.List<string>();
        var engine = BuildEngine as Microsoft.Build.Framework.IBuildEngine6;
        if (engine != null)
        {
            var globals = engine.GetGlobalProperties();
            foreach (var name in Names)
            {
                foreach (var key in globals.Keys)
                {
                    if (string.Equals(key, name.Trim(), System.StringComparison.OrdinalIgnoreCase) && !found.Contains(key))
                    {
                        found.Add(key);
                    }
                }
            }
        }
        Found = found.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    The modules' contract properties, as FluentMigrator.Net.Sdk lists them
    (keep the two lists the same). Add a custom pack's own properties here.
  -->
  <PropertyGroup>
    <SourceModelContractProperties>DatabaseDialect;DefaultSchema;IsDatabaseRootModule;VersionTableName;VersionTableSchema;SourceModelConvention;SourceModelRoot;EnableDefaultSourceModelItems;CustomSourceModelConventionPacks;FlywayLocationRoot;$(SourceModelContractProperties)</SourceModelContractProperties>
  </PropertyGroup>

  <!--
    FMSDK213: a module contract property arrived as a global property of the
    host. MSBuild passes it on to every module the host references, so
    `dotnet build AdventureHost -p:DatabaseDialect=postgres` would rebuild
    every module, root included, as postgres. A deployment target's dialect
    is set with the target's Dialect metadata instead. See FMSDK106 in
    FluentMigrator.Net.Sdk for why this warns rather than stripping the
    property from the references.
  -->
  <Target Name="WarnOnSourceModelContractGlobalProperties"
          BeforeTargets="ResolveProjectReferences;CollectDeploymentModules"
          Condition="'@(ProjectReference)' != ''">
    <FindHostGlobalProperties Names="$(SourceModelContractProperties)">
      <Output TaskParameter="Found" ItemName="_FmContractGlobalProperty" />
    </FindHostGlobalProperties>
    <PropertyGroup>
      <_FmContractGlobalPropertyList>@(_FmContractGlobalProperty, ', ')</_FmContractGlobalPropertyList>
      <_FmContractReferenceList>@(ProjectReference->'%(Filename)', ', ')</_FmContractReferenceList>
      <_FmContractGlobalPropertyText>Set as a global property: $(_FmContractGlobalPropertyList). MSBuild passes global properties on to referenced projects, so the value also applies to $(_FmContractReferenceList). Set the property in each module's project file or Directory.Build.props, and a target's dialect with its Dialect metadata.</_FmContractGlobalPropertyText>
    </PropertyGroup>
    <Warning Condition="'$(_FmContractGlobalPropertyList)' != '' and '$(TreatHostWarningsAsErrors)' != 'true'"
             Code="FMSDK213" Text="$(_FmContractGlobalPropertyText)" />
    <Error Condition="'$(_FmContractGlobalPropertyList)' != '' and '$(TreatHostWarningsAsErrors)' == 'true'"
           Code="FMSDK213" Text="$(_FmContractGlobalPropertyText)" />
  </Target>

  <!--
    Collect module info from every ProjectReference that speaks the
    GetDeploymentModuleInfo protocol (i.e. is a FluentMigrator.Net.Sdk
    module). Non-module references are skipped, not failed. Item order
    preserves ProjectReference declaration order, which is the default
    module order (root hoisted first) when a DeploymentTarget does not
    enumerate modules explicitly.
  -->
  <Target Name="CollectDeploymentModules">
    <MSBuild Projects="@(ProjectReference)"
             Targets="GetDeploymentModuleInfo"
             SkipNonexistentTargets="true"
             BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="DeploymentModule" />
    </MSBuild>
  </Target>

  <Target Name="BuildHostManifest"
          Condition="'$(GenerateHostManifest)' == 'true' and '$(HostManifestFile)' == ''"
          AfterTargets="CoreBuild"
          DependsOnTargets="CollectDeploymentModules">

    <BuildHostManifest Targets="@(DeploymentTarget)"
                       Modules="@(DeploymentModule)"
                       SelectedContexts="@(HostContext)"
                       KnownContexts="@(HostContextDefinition)"
                       RunnerPackages="@(MigrationRunnerPackage)"
                       ProjectName="$(MSBuildProjectName)"
                       ManifestPath="$(HostIntermediateManifestPath)"
                       TreatValidationWarningsAsErrors="$(TreatHostWarningsAsErrors)"
                       RequireSourceModelProvenance="$(RequireSourceModelProvenance)" />

    <Copy SourceFiles="$(HostIntermediateManifestPath)"
          DestinationFiles="$(HostManifestPath)"
          SkipUnchangedFiles="true" />

    <ItemGroup>
      <FileWrites Include="$(HostIntermediateManifestPath);$(HostManifestPath)" />
    </ItemGroup>

    <Message Importance="normal" Text="Host manifest -> $(HostManifestPath)" />
  </Target>

  <!--
    Escape hatch (Rails database.yml style): the user's hand-authored
    manifest is shipped verbatim. Their file, their order, their rules;
    graph linting is deliberately not applied to it.
  -->
  <!--
    Deliberately not Inputs/Outputs gated: switching a project onto a custom
    manifest usually leaves a *newer* generated manifest sitting in the
    output directory, and an up-to-date check would then skip the copy and
    silently keep shipping the generated one. Copy is cheap and
    SkipUnchangedFiles keeps the no-op case free.
  -->
  <Target Name="UseCustomHostManifest"
          Condition="'$(HostManifestFile)' != ''"
          AfterTargets="CoreBuild">

    <Error Condition="!Exists('$(HostManifestFile)')"
           Code="FMSDK206"
           Text="HostManifestFile '$(HostManifestFile)' does not exist." />

    <Copy SourceFiles="$(HostManifestFile)"
          DestinationFiles="$(HostManifestPath)"
          SkipUnchangedFiles="true" />

    <ItemGroup>
      <FileWrites Include="$(HostManifestPath)" />
    </ItemGroup>

    <Message Importance="normal" Text="Host manifest (custom) -> $(HostManifestPath)" />
  </Target>

  <!--
    Same reason as RegisterSourceModelFileWrites in FluentMigrator.Net.Sdk: the
    targets above run after CoreBuild, so after IncrementalClean, and their
    FileWrites were never recorded. Registered here from properties alone, so
    dotnet clean removes the host manifest, and switching to HostManifestFile
    removes the generated intermediate copy.
  -->
  <Target Name="RegisterHostManifestFileWrites" BeforeTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <FileWrites Include="$(HostIntermediateManifestPath);$(HostManifestPath)"
                  Condition="'$(GenerateHostManifest)' == 'true' and '$(HostManifestFile)' == ''" />
      <FileWrites Include="$(HostManifestPath)"
                  Condition="'$(HostManifestFile)' != ''" />
    </ItemGroup>
  </Target>

  <!-- Friendly standalone entry point: dotnet msbuild -t:HostManifest -->
  <Target Name="HostManifest"
          DependsOnTargets="BuildHostManifest;UseCustomHostManifest" />

</Project>
