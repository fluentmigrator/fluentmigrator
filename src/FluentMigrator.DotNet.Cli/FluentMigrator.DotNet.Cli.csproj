<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ToolCommandName>dotnet-fm</ToolCommandName>
    <PackAsTool>true</PackAsTool>
    <OutputType>Exe</OutputType>
    <Description>.NET Core CLI tool for FluentMigrator</Description>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../PackageTool.props" />
  <ItemGroup>
    <Compile Include="..\FluentMigrator.Runner.Core\DirtyAssemblyResolveHelper.cs" Link="DirtyAssemblyResolveHelper.cs" />
  </ItemGroup>
  <!-- Package versions come from Directory.Packages.props in the repository root. -->
  <ItemGroup>
    <!--
      Mapperly is a compile-time source generator. ExcludeAssets="runtime" and PrivateAssets="all"
      keep it out of the shipped tool entirely, so dotnet-fm gains no runtime mapping dependency.
    -->
    <PackageReference Include="Riok.Mapperly" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="McMaster.Extensions.CommandLineUtils" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!--
      Snowflake.Data 5.x requires Microsoft.Extensions.Logging 9.0.5. Overriding here rather than
      raising the shared floors in Directory.Packages.props keeps the shipped libraries on their
      8.0.0 minimum; dotnet-fm is a self-contained tool, so its own floor binds nobody.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" VersionOverride="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging" VersionOverride="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="Snowflake.Data" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluentMigrator.Runner\FluentMigrator.Runner.csproj" />
  </ItemGroup>
</Project>
