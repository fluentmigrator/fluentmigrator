<Project>
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <!--
      The .NET analyzers run by default only for net5.0+ targets; most
      libraries here target net48;netstandard2.0. Enabling them everywhere
      lets the rules raised in .editorconfig (CA1311) cover every project.
    -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TestingAot)' == 'true'">
    <DefineConstants>$(DefineConstants);TESTING_AOT</DefineConstants>
  </PropertyGroup>
</Project>
